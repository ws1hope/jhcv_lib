{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug YOLO (GPU)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Release/yolo_inference.exe",
            "args": [
                "-m", "${workspaceFolder}/models/model.onnx",
                "-i", "${workspaceFolder}/images/test.jpg",
                "-o", "${workspaceFolder}/images/result.jpg"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}\\build\\bin\\Release;G:\\3thirdparty\\onnxruntime\\lib;G:\\3thirdparty\\opencv\\build\\x64\\vc16\\bin;C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.2\\bin;G:\\3thirdparty\\tensorrt\\lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug OCR",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Release/ocr_inference.exe",
            "args": [
                "rec", //rec det all
                "${workspaceFolder}/images/image.png",
                //"${workspaceFolder}/models/ocr/det_model.onnx", det模式启用
                "${workspaceFolder}/models/ocr/rec_model.onnx",
                "${workspaceFolder}/models/ocr/best.yaml"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}\\build\\bin\\Release;G:\\3thirdparty\\onnxruntime\\lib;G:\\3thirdparty\\opencv\\build\\x64\\vc16\\bin;C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.2\\bin;G:\\3thirdparty\\tensorrt\\lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug PenmaRec",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Release/penma_rec.exe",
            "args": [
                "-i", "${workspaceFolder}/images/yuanbiao.jpg",
                "-l", "${workspaceFolder}/models/penma_rec/tiebiao_best_label.onnx",
                "-z", "${workspaceFolder}/models/penma_rec/tiebiao_best_zifu.onnx",
                "-r", "${workspaceFolder}/models/ocr/rec_model.onnx",
                "-c", "${workspaceFolder}/models/penma_rec/cls_model.onnx",
                "-L", "${workspaceFolder}/models/ocr/best.yaml",
                "-H", "25912522",
                "-o", "${workspaceFolder}/images/penma_result.jpg"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}\\build\\bin\\Release;G:\\3thirdparty\\onnxruntime\\lib;G:\\3thirdparty\\opencv\\build\\x64\\vc16\\bin;C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.2\\bin;G:\\3thirdparty\\tensorrt\\lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        }
        
    ]
}
