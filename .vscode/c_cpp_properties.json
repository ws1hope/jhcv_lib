{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/cv_infer",
                "/usr/local/include/opencv4",
                "/usr/local/include",
                "/usr/local/include/onnxruntime-1.21.1-cuda12.8-cudnn9-sm86-sm89-sm120-win-x64"
            ],
            "defines": [
                "USE_ONNXRUNTIME"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "macFrameworkPath": [
                "/Applications/Xcode.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ]
        },
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "G:/3thirdparty/opencv/build/include",
                "G:/3thirdparty/onnxruntime-1.21.1-cuda12.8-cudnn9-sm86-sm89-sm120-win-x64/include",
                "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v12.8/include",
                "G:/3thirdparty/tensorrt/include"
            ],
            "defines": [
                "USE_CUDA",
                "USE_ONNXRUNTIME"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}
