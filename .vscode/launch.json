{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug YOLO (GPU)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Release/yolo_inference.exe",
            "args": [
                "-m", "${workspaceFolder}/models/model.onnx",
                "-i", "${workspaceFolder}/images/test.jpg",
                "-o", "${workspaceFolder}/images/result.jpg"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}\\build\\bin\\Release;G:\\3thirdparty\\onnxruntime\\lib;G:\\3thirdparty\\opencv\\build\\x64\\vc16\\bin;C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.2\\bin;G:\\3thirdparty\\tensorrt\\lib;${env:PATH}"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build"
        },
