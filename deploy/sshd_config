# SteelAiLab SSH配置文件
# 基于Ubuntu 22.04默认配置修改

# SSH端口
Port 22

# 协议版本
Protocol 2

# 主机密钥
HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# 加密算法
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com,aes256-ctr,aes192-ctr,aes128-ctr
MACs hmac-sha2-256-etm@openssh.com,hmac-sha2-512-etm@openssh.com,hmac-sha2-256,hmac-sha2-512
KexAlgorithms curve25519-sha256@libssh.org,ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group16-sha512,diffie-hellman-group18-sha512,diffie-hellman-group14-sha256

# 认证配置
LoginGraceTime 120
PermitRootLogin yes
StrictModes yes
MaxAuthTries 6
MaxSessions 10

# 认证方法
PubkeyAuthentication yes
PasswordAuthentication yes
PermitEmptyPasswords no
ChallengeResponseAuthentication no
UsePAM no

# 日志配置
SyslogFacility AUTH
LogLevel INFO

# 连接配置
TCPKeepAlive yes
ClientAliveInterval 60
ClientAliveCountMax 3

# 安全配置
X11Forwarding yes
X11DisplayOffset 10
PrintMotd no
PrintLastLog yes
AcceptEnv LANG LC_*

# 子进程配置
Subsystem sftp /usr/lib/openssh/sftp-server

# 允许的用户
AllowUsers root

# 拒绝空密码
PermitEmptyPasswords no

# 环境变量配置
AcceptEnv LANG LC_* CUDA_HOME PATH LD_LIBRARY_PATH
