{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "if not exist \"${workspaceFolder}\\build\" mkdir \"${workspaceFolder}\\build\" && cmake -B \"${workspaceFolder}/build\" -S \"${workspaceFolder}\" -G \"Visual Studio 17 2022\" -A x64 -T v143"
            ],
            "problemMatcher": [],
            "detail": "CMake configure"
        },
        {
            "label": "build release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--config", "Release"
            ],
            "problemMatcher": "$msCompile",
            "detail": "CMake build Release"
        },
        {
            "label": "build debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--config", "Debug"
            ],
            "problemMatcher": "$msCompile",
            "detail": "CMake build Debug"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "echo",
            "args": ["build complete"],
            "dependsOrder": "sequence",
            "dependsOn": [
                "configure",
                "build release"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}